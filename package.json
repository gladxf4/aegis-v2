{
  "name": "aegisid",
  "version": "0.3.0",
  "private": true,
  "description": "Reusable privacy-preserving KYC claims with browser-side zero-knowledge proofs",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server/dev.js",
    "dev": "node server/dev.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "issuer:init": "node issuer/init.js",
    "build:circuits": "./circuits/scripts/build.sh",
    "prepare:web": "node scripts/prepare-web.js",
    "test": "node --test --test-force-exit tests/*.test.js",
    "test:coverage": "node --test --test-force-exit --experimental-test-coverage --test-coverage-include=\"api/**\" --test-coverage-include=\"lib/**\" --test-coverage-include=\"app/js/*.mjs\" --test-coverage-exclude=\"app/js/{main,navigation,prover,test-bench,ui,verify-view}.mjs\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 tests/*.test.js",
    "test:circuits": "node --test --test-force-exit tests/proof.test.js",
    "bench": "node bench/harness.js",
    "bench:export": "node bench/export.js"
  },
  "dependencies": {
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "circomlib": "2.0.5",
    "circomlibjs": "0.1.7",
    "eslint": "^10.15.0",
    "express": "5.2.1",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
