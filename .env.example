# Server secret used to sign challenge tokens. Required in production.
# Generate one with: openssl rand -base64 32
CHALLENGE_SECRET=

# Application name. The server derives the field element app_id from it.
# Default: aegisid-web
APP_ID=aegisid-web

# Trusted issuer key hash. Defaults to config/issuer.json.
# Set this only when the issuer key is managed outside the repository.
ISSUER_KEY_HASH=

# Challenge lifetime in seconds. Default: 300
CHALLENGE_TTL_SECONDS=300

# Enables POST /api/reset for the test bench. Never enable in production.
# AEGIS_DEMO=1

# Optional shared state. Set both URL and token to use Redis.
# Upstash Redis:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local development only.
# PORT=3000
